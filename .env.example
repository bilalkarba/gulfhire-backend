# ============================================================
# GulfHire Backend — Environment Variables
# ============================================================
# 1. Copy this file to `.env` (same directory) and fill in YOUR
#    real values (this example file is never loaded):
#        cp .env.example .env
# 2. Start the app:
#        ./mvnw spring-boot:run
#
# The `.env` file is loaded automatically on startup — from the
# current working directory OR from `gulfhire-backend/`, so it
# works whether you launch from the IDE (project root) or from
# the backend folder. Real OS/IDE environment variables OVERRIDE
# the `.env` file.
#
# Setting env vars without a .env file:
#   Linux/macOS (bash):  export DB_PASSWORD="..." && ./mvnw spring-boot:run
#   Windows (PowerShell): $env:DB_PASSWORD="..."; .\mvnw.cmd spring-boot:run
#   IntelliJ IDEA:       Run/Debug Configurations > Environment variables
#
# NEVER commit your real `.env` file to version control.
# ============================================================
#---------- PostgreSQL ----------
# Optional JDBC URL (defaults to localhost:5432/gulfhire_db)
DB_URL=jdbc:postgresql://localhost:5432/gulfhire_db

# Required — PostgreSQL user and password for the gulfhire_db database
DB_USERNAME=postgres
DB_PASSWORD=Bilal@2000

# ---------- JWT ----------
# Required — signs/verifies access + refresh tokens.
# MUST be at least 32 bytes (256 bits). Generate a strong one:\
#     openssl rand -base64 64
# The backend refuses to start while this example value is used.

JWT_SECRET_KEY=fR8sAcVUGe4tffK6YmEGxpEZ8Kl916ZuNkULNP1QHeWCL3EzMnMOn/m+gg6TK9Mm

# ---------- Cloudinary ----------
# Required — from your Cloudinary dashboard:
# https://console.cloudinary.com/settings/account  (API Keys tab)
CLOUDINARY_CLOUD_NAME=yjrgfesw
CLOUDINARY_API_KEY=429997761254277
CLOUDINARY_API_SECRET=eBSczpL4YvXo-4uTE0fFRQ1Z7Bs

# ---------- Email (optional — disabled until MAIL_ENABLED=true) ----------
# Set MAIL_ENABLED=true and fill these in to activate transactional email
# (application accepted/rejected, new message, password reset, verification).
# Example for Gmail app password: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=bilal.2000.12.6@gmail.com 
MAIL_PASSWORD=oexw nxby buoy bdsu
MAIL_FROM=bilalkarbach@gulfhire.com
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# ---------- Frontend (used to build links inside emails) ----------
FRONTEND_URL=http://localhost:4200

